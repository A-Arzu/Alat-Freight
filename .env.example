# ---- planner -----------------------------------------------------------
# auto (default): Gemini when GOOGLE_CLOUD_PROJECT is set, else deterministic fallback
# gemini | mock to force
PLANNER=auto
# gemini-3.5-flash is the GA Gemini 3.5 model (3.5 Pro not public yet)
GEMINI_MODEL=gemini-3.5-flash
PLANNER_TIMEOUT_S=150

# optional second-model audit: Gemma reviews Gemini's plan and flags any
# assignment it would decide differently (advisory - lowers confidence only).
# Off by default; needs a reachable Gemma model + GEMINI_API_KEY or Vertex creds.
ENABLE_GEMMA_AUDIT=false
GEMMA_MODEL=gemma-3-27b-it

# ---- Google Cloud (Cloud Run sets most of this) -------------------------
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# "global" routes model calls via Vertex's global endpoint, which serves GA
# Gemini models regardless of regional rollout (deploy.sh sets this too)
GOOGLE_CLOUD_LOCATION=global

# ---- storage: memory (local demo) | firestore (cloud) -------------------
STORE=memory
FS_PREFIX=dispatch

# ---- API protection for /optimize /events /api/seed ---------------------
RUN_TOKEN=demo-token

# ---- email delivery (optional; plan is always previewable in dashboard) --
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 + app password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# ---- demo pacing: ms between trace steps (0 in cloud if you like) -------
TRACE_DELAY_MS=300
